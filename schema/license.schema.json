{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ANZZ DEV License Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "updated_at", "licenses"],
  "properties": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "updated_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "token_hash",
          "user_id",
          "status",
          "type",
          "created_at",
          "expires_at"
        ],
        "properties": {
          "token_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "user_id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": ["active", "revoked"]
          },
          "type": {
            "enum": ["permanent", "term"]
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "features": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true
          },
          "max_devices": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
